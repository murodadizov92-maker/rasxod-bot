# Shu faylni Blocknot (Notepad) bilan oching va "=" dan keyin o'zingizniki bilan almashtiring.
# Bo'sh joy va qo'shtirnoq qo'ymang.

# BotFather bergan token
TELEGRAM_TOKEN=

# aistudio.google.com dan olingan Gemini kaliti
GEMINI_API_KEY=

# Botdan foydalana oladigan Telegram ID'lar (vergul bilan). Avval bo'sh qoldiring:
# botga /start yozsangiz, u sizning ID'ingizni ko'rsatadi, shuni shu yerga yozasiz.
ALLOWED_IDS=

# Kunlik avtomatik zaxira (baza fayli) shu Telegram ID'ga yuboriladi. Odatda o'zingizniki.
BACKUP_CHAT_ID=
